# Copy to /var/ossec/integrations/azure_devops.env, fill in, then:
#   sudo chmod 600 /var/ossec/integrations/azure_devops.env
#   sudo chown root:root /var/ossec/integrations/azure_devops.env
# NEVER commit the real file (*.env is gitignored).
export AZDO_ORG=YourOrganizationName
export AZDO_CLIENT_ID=00000000-0000-0000-0000-000000000000
export AZDO_TENANT_ID=00000000-0000-0000-0000-000000000000
export AZDO_CLIENT_SECRET=replace-me
